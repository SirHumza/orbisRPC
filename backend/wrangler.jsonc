{
  "name": "orbisrpc-auth",
  "main": "worker.js",
  "compatibility_date": "2026-11-21",
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "AuthSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthSession"] }],
  "ratelimits": [{ "name": "PAIR_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false }
}
